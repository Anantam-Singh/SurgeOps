PORT=5000

# MongoDB connection string (Atlas or self-hosted). Required.
MONGO_URI=

# Default surge threshold used when no config document / area override exists.
DEFAULT_SURGE_PCT=50

# Reasoning provider: "offline" (no external API, always available), "gemini", or "openai".
# Falls back to the offline generator automatically if the chosen provider errors or has no key.
AI_PROVIDER=offline
AI_MODEL=

# Only needed if AI_PROVIDER=gemini
GEMINI_KEY=

# Only needed if AI_PROVIDER=openai
OPENAI_KEY=

# Optional: enables live weather enrichment (https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# Cron schedule for area recalibration + ML model retraining (node-cron syntax)
RECALIBRATION_CRON=*/30 * * * *

# OAuth (Google / GitHub) — register apps at:
#  Google: https://console.cloud.google.com/apis/credentials (redirect URI: {SERVER_BASE_URL}/api/auth/google/callback)
#  GitHub: https://github.com/settings/developers          (callback URL:  {SERVER_BASE_URL}/api/auth/github/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs the post-OAuth session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend origin OAuth redirects back to after login.
CLIENT_URL=http://localhost:3000

# Backend's own public URL, used to build the OAuth callback URLs registered above.
SERVER_BASE_URL=http://localhost:5000
